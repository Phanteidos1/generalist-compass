{
  "crons": [
    {
      "path": "/api/weekly",
      "schedule": "0 7 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/f2",
      "destination": "/f2.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/cv",
      "destination": "/cv.html"
    },
    {
      "source": "/cv/:id",
      "destination": "/cv.html"
    }
  ],
  "headers": [
    {
      "source": "/cv/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
